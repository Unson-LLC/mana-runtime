{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mana company authority retrieval state fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "expected_code", "business_effect"],
        "properties": {
          "id": { "type": "string", "pattern": "^NEG-AUTHORITY-RETRIEVAL-[A-Z_]+$" },
          "state": { "enum": ["no_data", "unknown", "partial", "not_collected"] },
          "expected_code": { "const": "AUTHORITY_UNAVAILABLE" },
          "business_effect": { "const": false }
        }
      }
    }
  }
}
