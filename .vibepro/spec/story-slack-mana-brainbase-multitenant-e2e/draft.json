      "Return explicit deny, unavailable, empty, partial, and timeout semantics."
    ],
    "mana_runtime": [
      "Verify Slack authenticity and transport the immutable tenant context envelope across every runtime boundary.",
      "Revalidate workspace connection revision and authorization before tools, Brainbase API calls, and Slack delivery.",
      "Partition queue, durable state, container/sandbox, tools, credentials, results, and reply delivery by tenant scope.",
      "Enforce correlation and idempotency for Brainbase writes and Slack replies.",
      "Observe usage, report partial or unknown usage honestly, and emit one reply outcome."
    ],
    "shared_contract": [
      "Maintain protocol version and compatibility fixtures.",
      "Use the same failure codes and Receipt schema in Cloud and compatible OSS.",
      "Prohibit all implicit fallback paths and preserve not_collected as distinct from zero or success."
