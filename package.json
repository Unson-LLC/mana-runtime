{
  "name": "mana-runtime",
  "version": "0.8.0",
  "private": true,
  "description": "Cloudflare-native execution runtime for Mana operating agents",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @mana-runtime/cloud-runtime build",
    "build:unson-business": "pnpm --filter @mana-runtime/cloud-runtime build:unson-business",
    "build:dedicated-cloud": "pnpm --filter @mana-runtime/cloud-runtime build:dedicated-cloud",
    "build:customer-managed": "pnpm --filter @mana-runtime/cloud-runtime build:customer-managed-oss",
    "dev": "pnpm --filter @mana-runtime/cloud-runtime dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @mana-runtime/cloud-runtime test && pnpm --filter @mana-runtime/slack-thread-context test && pnpm --filter @mana-runtime/task-runtime-core test && pnpm --filter @mana-runtime/write-broker test",
    "test:cloud": "pnpm --filter @mana-runtime/cloud-runtime test",
    "verify:production-task-migration-evidence": "pnpm --filter @mana-runtime/cloud-runtime verify:production-task-migration-evidence",
    "deploy:unson-business": "pnpm --filter @mana-runtime/cloud-runtime deploy:unson-business",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
