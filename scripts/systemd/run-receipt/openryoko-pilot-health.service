[Unit]
Description=Check OpenRyoko pilot health
After=openryoko.service openryoko-run-receipt.timer
Wants=openryoko.service openryoko-run-receipt.timer

[Service]
Type=oneshot
User=ryoko
Group=ryoko
WorkingDirectory=/home/ryoko
Environment=HOME_DIR=/home/ryoko
ExecStart=/home/ryoko/bin/openryoko-pilot-health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
