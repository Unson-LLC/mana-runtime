#!/usr/bin/env bash
# Build and atomically activate one reviewed origin/main commit on the pilot host.
set -euo pipefail

readonly DEPLOY_TESTING="${OPENRYOKO_DEPLOY_TESTING:-0}"
if [[ "$DEPLOY_TESTING" == "1" ]]; then
  readonly RUNTIME_USER="${OPENRYOKO_TEST_RUNTIME_USER:-ryoko}"
  readonly RUNTIME_HOME="${OPENRYOKO_TEST_RUNTIME_HOME:?}"
  readonly SOURCE_REPO="${OPENRYOKO_TEST_SOURCE_REPO:?}"
  readonly RELEASES_DIR="${OPENRYOKO_TEST_RELEASES_DIR:?}"
  readonly CURRENT_LINK="${OPENRYOKO_TEST_CURRENT_LINK:?}"
  readonly SERVICE="${OPENRYOKO_TEST_SERVICE:-openryoko.service}"
  readonly RESTART_GUARD="${OPENRYOKO_TEST_RESTART_GUARD:?}"
  readonly LOCK_FILE="${OPENRYOKO_TEST_LOCK_FILE:?}"
  readonly PNPM_BIN="${OPENRYOKO_TEST_PNPM_BIN:?}"
  readonly DEPLOY_SCRIPT_PATH="${OPENRYOKO_TEST_DEPLOY_SCRIPT_PATH:?}"
  readonly DEPLOY_COMMAND_PATH="${OPENRYOKO_TEST_DEPLOY_COMMAND_PATH:?}"
  readonly ACTIVE_CHECK_ATTEMPTS="${OPENRYOKO_TEST_ACTIVE_CHECK_ATTEMPTS:-1}"
  readonly GOOGLE_DRIVE_MCP_ADAPTER="${OPENRYOKO_TEST_GOOGLE_DRIVE_MCP_ADAPTER:-$RUNTIME_HOME/mcp/google-drive-server.js}"
else
  readonly RUNTIME_USER="ryoko"
  readonly RUNTIME_HOME="/home/ryoko"
  readonly SOURCE_REPO="$RUNTIME_HOME/src/OpenRyoko"
  readonly RELEASES_DIR="$RUNTIME_HOME/releases/openryoko"
  readonly CURRENT_LINK="$RUNTIME_HOME/current"
  readonly SERVICE="openryoko.service"
  readonly RESTART_GUARD="/usr/local/libexec/openryoko-guard-restart"
  readonly LOCK_FILE="/run/lock/openryoko-pilot-deploy.lock"
  readonly PNPM_BIN="$RUNTIME_HOME/.nvm/versions/node/v22.23.1/bin/pnpm"
  readonly DEPLOY_SCRIPT_PATH="/usr/local/sbin/openryoko-pilot-deploy"
  readonly DEPLOY_COMMAND_PATH="/usr/local/sbin/openryoko-deploy-command"
  readonly ACTIVE_CHECK_ATTEMPTS=30
  readonly GOOGLE_DRIVE_MCP_ADAPTER="$RUNTIME_HOME/mcp/google-drive-server.js"
fi
readonly RELEASE_KEEP_COUNT=3

die() {
  echo "openryoko deploy: $*" >&2
  exit 1
}

control_plane_digest() {
  {
    sha256sum "$DEPLOY_SCRIPT_PATH" | cut -d' ' -f1
    sha256sum "$DEPLOY_COMMAND_PATH" | cut -d' ' -f1
  } | sha256sum | cut -d' ' -f1
}

run_as_runtime() {
  if [[ "$DEPLOY_TESTING" == "1" ]]; then
    "$@"
    return
  fi
  runuser -u "$RUNTIME_USER" -- env \
    HOME="$RUNTIME_HOME" \
    PATH="$(dirname "$PNPM_BIN"):/usr/local/bin:/usr/bin:/bin" \
    "$@"
}

run_as_runtime_at() {
  local working_dir="$1"
  shift
  (
    cd "$working_dir"
    run_as_runtime "$@"
  )
}

rollback_activation() {
  local failed_status="$1"
  local current_link="$2"
  local previous_target="$3"
  local service="$4"

  if [[ -n "$previous_target" && -d "$previous_target" ]]; then
    echo "openryoko deploy: activation failed; rolling back to $(basename "$previous_target")" >&2
    local rollback_link="${current_link}.rollback.$$"
    ln -s "$previous_target" "$rollback_link"
    mv -Tf "$rollback_link" "$current_link"
    systemctl restart "$service" || true
  fi
  return "$failed_status"
}

if [[ "${OPENRYOKO_DEPLOY_SOURCE_ONLY:-0}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

[[ $# -eq 2 ]] || die "usage: openryoko-pilot-deploy FULL_COMMIT_SHA CONTROL_PLANE_SHA256"
target_sha="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
expected_control_plane_digest="$2"
[[ "$target_sha" =~ ^[0-9a-f]{40}$ ]] || die "commit must be a full 40-character lowercase hexadecimal SHA"
[[ "$expected_control_plane_digest" =~ ^[0-9a-f]{64}$ ]] || die "control-plane digest must be a lowercase SHA-256"
actual_control_plane_digest="$(control_plane_digest)"
[[ "$actual_control_plane_digest" == "$expected_control_plane_digest" ]] \
  || die "installed deploy control plane does not match the requested commit"
[[ $EUID -eq 0 || "$DEPLOY_TESTING" == "1" ]] || die "must run as root"
[[ -x "$PNPM_BIN" ]] || die "pnpm not found at the pinned pilot path"
[[ -x "$RESTART_GUARD" ]] || die "restart guard is not installed"
[[ -d "$SOURCE_REPO/.git" ]] || die "runtime source repository is missing"

exec 9>"$LOCK_FILE"
flock -n 9 || die "another deployment is already running"

install -d -o "$RUNTIME_USER" -g "$RUNTIME_USER" -m 0755 "$RELEASES_DIR"

echo "openryoko deploy: fetching origin/main"
run_as_runtime git -C "$SOURCE_REPO" fetch --no-tags origin main
run_as_runtime git -C "$SOURCE_REPO" cat-file -e "${target_sha}^{commit}"
run_as_runtime git -C "$SOURCE_REPO" merge-base --is-ancestor "$target_sha" origin/main \
  || die "requested commit is not reachable from origin/main"

release_dir="$RELEASES_DIR/${target_sha}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
echo "openryoko deploy: preparing isolated release $target_sha"
run_as_runtime git -C "$SOURCE_REPO" worktree add --detach "$release_dir" "$target_sha"
build_ok=0
cleanup_incomplete_release() {
  if (( build_ok == 0 )); then
    run_as_runtime git -C "$SOURCE_REPO" worktree remove --force "$release_dir" >/dev/null 2>&1 || true
  fi
}
trap cleanup_incomplete_release EXIT
run_as_runtime_at "$release_dir" "$PNPM_BIN" --dir "$release_dir" install --frozen-lockfile
run_as_runtime_at "$release_dir" "$PNPM_BIN" --dir "$release_dir" build
[[ -f "$release_dir/packages/jimmy/dist/bin/jimmy.js" ]] || die "build did not create the Jimmy entrypoint"
[[ -f "$release_dir/packages/jimmy/dist/src/mcp/google-drive-server.js" ]] \
  || die "build did not create the Google Drive MCP adapter"
[[ "$(run_as_runtime git -C "$release_dir" rev-parse HEAD)" == "$target_sha" ]] \
  || die "release worktree HEAD does not match the requested commit"
build_ok=1
trap - EXIT

previous_target=""
if [[ -L "$CURRENT_LINK" ]]; then
  previous_target="$(realpath "$CURRENT_LINK" || true)"
fi

echo "openryoko deploy: waiting for development runner before restart"
"$RESTART_GUARD" --wait 5400

rollback() {
  local failed_status="${1:-$?}"
  trap - ERR
  rollback_activation "$failed_status" "$CURRENT_LINK" "$previous_target" "$SERVICE" || true
  exit "$failed_status"
}
trap 'rollback $?' ERR

next_link="${CURRENT_LINK}.next.$$"
ln -s "$release_dir" "$next_link"
mv -Tf "$next_link" "$CURRENT_LINK"

# The MCP catalog intentionally points at this stable path. Make it follow the
# active release pointer so normal deploys and rollbacks switch the adapter too.
install -d -o "$RUNTIME_USER" -g "$RUNTIME_USER" -m 0755 "$(dirname "$GOOGLE_DRIVE_MCP_ADAPTER")"
adapter_link="${GOOGLE_DRIVE_MCP_ADAPTER}.next.$$"
ln -s "$CURRENT_LINK/packages/jimmy/dist/src/mcp/google-drive-server.js" "$adapter_link"
mv -Tf "$adapter_link" "$GOOGLE_DRIVE_MCP_ADAPTER"

systemctl restart "$SERVICE" || rollback $?
for ((attempt = 0; attempt < ACTIVE_CHECK_ATTEMPTS; attempt += 1)); do
  if systemctl is-active --quiet "$SERVICE"; then
    break
  fi
  sleep 1
done
systemctl is-active --quiet "$SERVICE" || rollback $?
active_entrypoint="$(realpath "$CURRENT_LINK/packages/jimmy/dist/bin/jimmy.js")"
expected_entrypoint="$(realpath "$release_dir/packages/jimmy/dist/bin/jimmy.js")"
if [[ "$active_entrypoint" != "$expected_entrypoint" ]]; then
  echo "openryoko deploy: active entrypoint does not match the requested release" >&2
  rollback 1
fi
active_drive_adapter="$(realpath "$GOOGLE_DRIVE_MCP_ADAPTER")"
expected_drive_adapter="$(realpath "$release_dir/packages/jimmy/dist/src/mcp/google-drive-server.js")"
if [[ "$active_drive_adapter" != "$expected_drive_adapter" ]]; then
  echo "openryoko deploy: Google Drive MCP adapter does not match the requested release" >&2
  rollback 1
fi
main_pid="$(systemctl show --property MainPID --value "$SERVICE")"
[[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || rollback 1
if [[ "$DEPLOY_TESTING" == "1" && -n "${OPENRYOKO_TEST_PROCESS_COMMAND:-}" ]]; then
  process_command="$OPENRYOKO_TEST_PROCESS_COMMAND"
else
  process_command="$(tr '\0' ' ' < "/proc/$main_pid/cmdline")"
fi
if [[ "$process_command" != *"$CURRENT_LINK/packages/jimmy/dist/bin/jimmy.js"* ]]; then
  echo "openryoko deploy: systemd process is not running the release-pointer entrypoint" >&2
  rollback 1
fi
trap - ERR

echo "openryoko deploy: active commit $target_sha"
echo "openryoko deploy: control plane digest $actual_control_plane_digest"
echo "openryoko deploy: main pid $main_pid"
echo "openryoko deploy: entrypoint $active_entrypoint"
echo "openryoko deploy: Google Drive MCP adapter $active_drive_adapter"

# Keep the active and immediately previous releases even when pruning old worktrees.
kept=0
while IFS= read -r path; do
  path="${path%/}"
  if [[ "$path" == "$release_dir" || "$path" == "$previous_target" || $kept -lt $RELEASE_KEEP_COUNT ]]; then
    ((kept += 1))
    continue
  fi
  run_as_runtime git -C "$SOURCE_REPO" worktree remove --force "$path" >/dev/null 2>&1 || true
done < <(ls -1dt "$RELEASES_DIR"/*/ 2>/dev/null || true)
if ! run_as_runtime git -C "$SOURCE_REPO" worktree prune; then
  echo "openryoko deploy: warning: worktree metadata pruning failed after successful activation" >&2
fi
