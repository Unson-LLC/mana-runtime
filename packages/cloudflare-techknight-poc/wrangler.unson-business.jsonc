\",\"name\":\"Tech Knight\"},\"slackChannelId\":\"C0A2RB6803B\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"tech-knight-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}}]",
    "RUNTIME_PLACEMENT_ID": "mana-accounting",
    "RUNTIME_PLACEMENTS_JSON": "[{\"placementId\":\"mana-accounting\",\"channelId\":\"C0BKS6RL99T\",\"projectCodes\":[\"back-office\"],\"taskWriteEnabled\":true,\"taskBoardEnabled\":true},{\"placementId\":\"biz-meeting-router\",\"channelId\":\"C0BKTFQ9V38\",\"projectCodes\":[\"unson\"],\"taskWriteEnabled\":true},{\"placementId\":\"mana-dev-biz\",\"channelId\":\"C0BMNSP6C80\",\"projectCodes\":[\"mana\"],\"taskWriteEnabled\":true,\"taskBoardEnabled\":true,\"developmentEnabled\":true,\"audience\":{\"type\":\"operator\",\"allowedUserIds\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"]},\"agent\":{\"model\":\"sonnet\",\"escalationEmployee\":\"critical-reviewer\"},\"runtimeContext\":{\"persona\":\"Ryoko（佐藤圭吾のパーソナルAIアシスタント兼AI組織のCOO）\",\"instructions\":[\"結論を先に日本語で簡潔かつ具体的に答える\",\"確認できないことは推測せず不確実性を正直に伝える\",\"利用者の意図を先読みして次の行動を提案する\"],\"skills\":[\"cron-manager\",\"find-and-install\",\"management\",\"migrate\",\"new\",\"onboarding\",\"self-heal\",\"skill-creator\",\"status\",\"sync\"]},\"respondTo\":{\"im\":\"never\",\"mpim\":\"never\",\"channel\":\"mention\",\"engagedThreads\":true},\"capabilities\":{\"mcp\":[\"brainbase\",\"nocodb\",\"gateway\",\"google-drive\"],\"gatewayTools\":[\"send_message\",\"create_task\",\"list_tasks\",\"update_task\",\"transition_task\",\"list_sessions\",\"get_session\",\"list_employees\",\"get_employee\"]},\"dataScopes\":{\"graph\":{\"mode\":\"read-only\",\"scopes\":[\"org:unson\"]}},\"deliveryScopes\":[{\"connector\":\"slack\",\"channelId\":\"C0BMNSP6C80\"}]}]",
    "RUNTIME_CLAUDE_MODEL": "opus",
    "RUNTIME_CLAUDE_EFFORT": "xhigh",
    "RUNTIME_CRON_JOBS_JSON": "[]",
    "RUNTIME_EMPLOYEES_JSON": "[{\"name\":\"critical-reviewer\",\"displayName\":\"Critical Reviewer\",\"department\":\"executive\",\"rank\":\"senior\",\"engine\":\"claude\",\"model\":\"opus\",\"effortLevel\":\"xhigh\",\"emoji\":\"🔬\",\"alwaysNotify\":true,\"persona\":\"You handle only high-impact work where the additional latency and Max usage are justified: architecture decisions, security or privacy analysis, irreversible operational changes, and final review of important deliverables. Separate confirmed facts, evidence, inference, and unresolved items. Do not make external changes unless the parent task explicitly authorizes them.\",\"provides\":[{\"name\":\"critical-analysis\",\"description\":\"重要な設計・セキュリティ・不可逆変更をOpus/xhighで精査する\"},{\"name\":\"final-critical-review\",\"description\":\"重要成果物をOpus/xhighで最終レビューする\"}]}]"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHKNIGHT_WORKSPACE",
        "class_name": "TechKnightWorkspace"
      },
      {
        "name": "TECHKNIGHT_SANDBOX",
        "class_name": "TechKnightSandbox"
      },
      {
        "name": "TASK_WRITE_BUDGETS",
        "class_name": "TaskWriteBudget"
      },
      {
        "name": "MEETING_MINUTES_WORKSPACE",
        "class_name": "MeetingMinutesWorkspace"
      },
      {
        "name": "TASK_WRITE_APPROVALS",
        "class_name": "TaskWriteApproval"
      },
      {
        "name": "RUNTIME_SESSION_REGISTRY",
        "class_name": "RuntimeSessionRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechKnightWorkspace"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TechKnightSandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TaskWriteBudget"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["MeetingMinutesWorkspace"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TaskWriteApproval"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["RuntimeSessionRegistry"]
    }
  ],
  "containers": [
    {
      "class_name": "TechKnightSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TECHKNIGHT_EVENTS",
        "queue": "unson-business-mana-runtime-events"
      },
      {
        "binding": "TASK_BOARD_REPAIRS",
        "queue": "unson-business-mana-task-board-repairs"
      }
    ],
    "consumers": [
      {
        "queue": "unson-business-mana-runtime-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "unson-business-mana-runtime-events-dlq"
      },
      {
        "queue": "unson-business-mana-task-board-repairs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-mana-task-board-repairs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
