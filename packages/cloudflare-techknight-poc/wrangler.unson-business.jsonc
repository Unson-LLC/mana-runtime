    "MEETING_MINUTES_DESTINATIONS_JSON": "[{\"id\":\"baao-growin\",\"projectId\":\"proj_baao_growin\",\"name\":\"BAAO Growin\",\"organization\":{\"id\":\"unson-business\",\"name\":\"雲孫 事業運営\"},\"slackChannelId\":\"C0BKTFU9YS2\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"baao-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"zeims\",\"projectId\":\"proj_zeims\",\"name\":\"ZEIMS\",\"organization\":{\"id\":\"unson-business\",\"name\":\"雲孫 事業運営\"},\"slackChannelId\":\"C0BKE4CM25V\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"zeims-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"ncom-catalyst\",\"projectId\":\"proj_ncom_catalyst\",\"name\":\"NCOM Catalyst\",\"organization\":{\"id\":\"unson-business\",\"name\":\"雲孫 事業運営\"},\"slackChannelId\":\"C0BKP89E79R\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"ncom-catalyst\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"unson-board\",\"projectId\":\"proj_unson_board\",\"name\":\"Unson Board\",\"organization\":{\"id\":\"unson\",\"name\":\"雲孫\"},\"slackChannelId\":\"C0BKXCVSDCH\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"Drive\",\"branch\":\"main\",\"pathPrefix\":\"meetings/unson-board/\"}},{\"id\":\"back-office\",\"projectId\":\"proj_back_office\",\"name\":\"Back Office\",\"organization\":{\"id\":\"unson-business\",\"name\":\"雲孫 事業運営\"},\"slackChannelId\":\"C0BKS6RL99T\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"back_office\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"brainbase\",\"projectId\":\"proj_brainbase\",\"name\":\"Brainbase\",\"organization\":{\"id\":\"unson-business\",\"name\":\"雲孫 事業運営\"},\"slackChannelId\":\"C0BKE4D0TK9\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"brainbase-unson\",\"branch\":\"develop\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"tech-knight\",\"projectId\":\"proj_tech-knight\",\"name\":\"株式会社TechKnight\",\"organization\":{\"id\":\"tech-knight\",\"name\":\"Tech Knight\"},\"slackChannelId\":\"C09RPFX1403\",