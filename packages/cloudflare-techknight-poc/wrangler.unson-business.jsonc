{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "788e556343893a7135c29b782c22fb24",
  "name": "unson-business-mana-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TENANT_ID": "unson-business",
    "SLACK_EXPECTED_TEAM_ID": "T0882T8N9UH",
    "SLACK_EXPECTED_APP_ID": "A0BPM2J33SN",
    "SLACK_ALLOWED_CHANNEL_ID": "C0BKS6RL99T",
    "BRAINBASE_TASK_API_BASE_URL": "https://bb.unson.jp",
    "RUNTIME_PROJECT_CODES": "back-office",
    "RUNTIME_EXECUTION_MODE": "meeting_tasks",
    "RUNTIME_CLAUDE_MODEL": "opus",
    "RUNTIME_CLAUDE_EFFORT": "xhigh"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHKNIGHT_WORKSPACE",
        "class_name": "TechKnightWorkspace"
      },
      {
        "name": "TECHKNIGHT_SANDBOX",
        "class_name": "TechKnightSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechKnightWorkspace"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TechKnightSandbox"]
    }
  ],
  "containers": [
    {
      "class_name": "TechKnightSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TECHKNIGHT_EVENTS",
        "queue": "unson-business-mana-runtime-events"
      }
    ],
    "consumers": [
      {
        "queue": "unson-business-mana-runtime-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-mana-runtime-events-dlq"
      }
    ]
  }
}
