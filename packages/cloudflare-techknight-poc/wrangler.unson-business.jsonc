{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "788e556343893a7135c29b782c22fb24",
  "name": "unson-business-mana-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TENANT_ID": "unson-business",
    "SLACK_EXPECTED_TEAM_ID": "T0882T8N9UH",
    "SLACK_EXPECTED_APP_ID": "A0BPM2J33SN",
    "SLACK_ALLOWED_CHANNEL_ID": "C0BKS6RL99T",
    "BRAINBASE_TASK_API_BASE_URL": "https://bb.unson.jp",
    "BRAINBASE_GRAPH_API_BASE_URL": "https://bb.unson.jp",
    "RUNTIME_PROJECT_CODES": "back-office",
    "RUNTIME_EXECUTION_MODE": "meeting_tasks",
    "RUNTIME_TASK_SEARCH_ENABLED": "true",
    "RUNTIME_TASK_WRITE_ENABLED": "true",
    "TASK_WRITE_POLICY_JSON": "{\"version\":\"unson-business-v2\",\"rules\":[{\"effect\":\"deny\",\"actors\":[\"*\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.transition\"]},{\"effect\":\"auto\",\"actors\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.create\",\"task.update\"]},{\"effect\":\"auto\",\"actors\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"placements\":[\"mana-dev-biz\"],\"projects\":[\"mana\"],\"operations\":[\"task.create\",\"task.update\",\"task.transition\"]},{\"effect\":\"approval\",\"actors\":[\"*\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.create\",\"task.update\"],\"approvers\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"ttlSeconds\":120}]}",
    "RUNTIME_TASK_BOARD_ENABLED": "true",
    "MEETING_MINUTES_ENABLED": "true",
    "MEETING_MINUTES_ROUTER_CHANNEL_ID": "C0BKTFQ9V38",
    "MEETING_MINUTES_OPERATOR_USER_IDS": "U088D1HBY6L,U0BKP8D3KPD",
    "MEETING_MINUTES_DESTINATIONS_JSON": "[{\"id\":\"baao-growin\",\"projectId\":\"proj_baao_growin\",\"name\":\"BAAO Growin\",\"slackChannelId\":\"C0BKTFU9YS2\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"baao-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"zeims\",\"projectId\":\"proj_zeims\",\"name\":\"ZEIMS\",\"slackChannelId\":\"C0BKE4CM25V\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"zeims-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"ncom-catalyst\",\"projectId\":\"proj_ncom_catalyst\",\"name\":\"NCOM Catalyst\",\"slackChannelId\":\"C0BKP89E79R\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"ncom-catalyst\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"unson-board\",\"projectId\":\"proj_unson_board\",\"name\":\"Unson Board\",\"slackChannelId\":\"C0BKXCVSDCH\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"Drive\",\"branch\":\"main\",\"pathPrefix\":\"meetings/unson-board/\"}},{\"id\":\"back-office\",\"projectId\":\"proj_back_office\",\"name\":\"Back Office\",\"slackChannelId\":\"C0BKS6RL99T\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"back_office\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"brainbase\",\"projectId\":\"proj_brainbase\",\"name\":\"Brainbase\",\"slackChannelId\":\"C0BKE4D0TK9\",\"github\":{\"owner\":\"Unson-LLC\",\"repo\":\"brainbase-unson\",\"branch\":\"develop\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"tech-knight\",\"projectId\":\"proj_tech-knight\",\"name\":\"TechKnight / 株式会社TechKnight\",\"slackChannelId\":\"C09RPFX1403\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"tech-knight-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"aitle\",\"projectId\":\"proj_aitle\",\"name\":\"TechKnight / Aitle\",\"slackChannelId\":\"C08UNE2BVJ7\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"Aitle\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"smartfront\",\"projectId\":\"proj_smartfront\",\"name\":\"TechKnight / SmartFront\",\"slackChannelId\":\"C0A489A4EFJ\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"smartfront\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"hp-sales\",\"projectId\":\"proj_hp_sales\",\"name\":\"TechKnight / HP制作\",\"slackChannelId\":\"C0A3AGMS68M\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"web-inn\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"senpainurse\",\"projectId\":\"proj_senpainurse\",\"name\":\"TechKnight / センパイナース\",\"slackChannelId\":\"C0A9J7UV1KL\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"senpainurse\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}},{\"id\":\"techknight-board\",\"projectId\":\"proj_techknight_board\",\"name\":\"TechKnight / ボード定例\",\"slackChannelId\":\"C0A2RB6803B\",\"github\":{\"owner\":\"Tech-Knight-inc\",\"repo\":\"tech-knight-project\",\"branch\":\"main\",\"pathPrefix\":\"meetings/\"}}]",
    "RUNTIME_PLACEMENT_ID": "mana-accounting",
    "RUNTIME_PLACEMENTS_JSON": "[{\"placementId\":\"mana-accounting\",\"channelId\":\"C0BKS6RL99T\",\"projectCodes\":[\"back-office\"],\"taskWriteEnabled\":true},{\"placementId\":\"biz-meeting-router\",\"channelId\":\"C0BKTFQ9V38\",\"projectCodes\":[\"unson\"],\"taskWriteEnabled\":false},{\"placementId\":\"mana-dev-biz\",\"channelId\":\"C0BMNSP6C80\",\"projectCodes\":[\"mana\"],\"taskWriteEnabled\":true,\"audience\":{\"type\":\"operator\",\"allowedUserIds\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"]},\"agent\":{\"model\":\"sonnet\",\"escalationEmployee\":\"critical-reviewer\"},\"capabilities\":{\"mcp\":[\"brainbase\",\"nocodb\",\"gateway\",\"google-drive\"],\"gatewayTools\":[\"send_message\",\"create_task\",\"list_tasks\",\"update_task\",\"transition_task\",\"list_sessions\",\"get_session\",\"list_employees\",\"get_employee\"]},\"dataScopes\":{\"graph\":{\"mode\":\"read-only\",\"scopes\":[\"org:unson\"]}},\"deliveryScopes\":[{\"connector\":\"slack\",\"channelId\":\"C0BMNSP6C80\"}]}]",
    "RUNTIME_CLAUDE_MODEL": "opus",
    "RUNTIME_CLAUDE_EFFORT": "xhigh"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHKNIGHT_WORKSPACE",
        "class_name": "TechKnightWorkspace"
      },
      {
        "name": "TECHKNIGHT_SANDBOX",
        "class_name": "TechKnightSandbox"
      },
      {
        "name": "TASK_WRITE_BUDGETS",
        "class_name": "TaskWriteBudget"
      },
      {
        "name": "MEETING_MINUTES_WORKSPACE",
        "class_name": "MeetingMinutesWorkspace"
      },
      {
        "name": "TASK_WRITE_APPROVALS",
        "class_name": "TaskWriteApproval"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechKnightWorkspace"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TechKnightSandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TaskWriteBudget"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["MeetingMinutesWorkspace"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TaskWriteApproval"]
    }
  ],
  "containers": [
    {
      "class_name": "TechKnightSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TECHKNIGHT_EVENTS",
        "queue": "unson-business-mana-runtime-events"
      },
      {
        "binding": "TASK_BOARD_REPAIRS",
        "queue": "unson-business-mana-task-board-repairs"
      }
    ],
    "consumers": [
      {
        "queue": "unson-business-mana-runtime-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-mana-runtime-events-dlq"
      },
      {
        "queue": "unson-business-mana-task-board-repairs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-mana-task-board-repairs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
