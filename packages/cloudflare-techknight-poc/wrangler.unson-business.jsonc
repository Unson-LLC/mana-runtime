    "TASK_WRITE_POLICY_JSON": "{\"version\":\"unson-business-v2\",\"rules\":[{\"effect\":\"deny\",\"actors\":[\"*\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.transition\"]},{\"effect\":\"auto\",\"actors\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.create\",\"task.update\"]},{\"effect\":\"approval\",\"actors\":[\"*\"],\"placements\":[\"mana-accounting\"],\"projects\":[\"back-office\"],\"operations\":[\"task.create\",\"task.update\"],\"approvers\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"ttlSeconds\":120},{\"effect\":\"deny\",\"actors\":[\"*\"],\"placements\":[\"biz-meeting-router\"],\"projects\":[\"unson\"],\"operations\":[\"task.transition\"]},{\"effect\":\"approval\",\"actors\":[\"*\"],\"placements\":[\"biz-meeting-router\"],\"projects\":[\"unson\"],\"operations\":[\"task.create\",\"task.update\"],\"approvers\":[\"U088D1HBY6L\",\"U0BKP8D3KPD\"],\"ttlSeconds\":300}]}",
