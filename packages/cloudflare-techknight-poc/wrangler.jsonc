{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techknight-mana-runtime-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TENANT_ID": "techknight",
    "SLACK_EXPECTED_TEAM_ID": "T07A9J3PEMB",
    "SLACK_ALLOWED_CHANNEL_ID": "C0A1UQNLSBD",
    "RUNTIME_EXECUTION_MODE": "reply_only",
    "RUNTIME_TASK_SEARCH_ENABLED": "false",
    "RUNTIME_CLAUDE_MODEL": "opus",
    "RUNTIME_CLAUDE_EFFORT": "xhigh",
    "MANA_DEPLOYMENT_PROFILE": "shared_cloud",
    "MANA_CREDENTIAL_AUDIENCE": "api.anthropic.com",
    "MANA_RUNTIME_CAPABILITIES": "signed_tenant_context,connection_revision_recheck,tenant_scoped_authorization,credential_broker_v1,usage_receipt_v1,idempotent_effects_v1,container_sanitization_v1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHKNIGHT_WORKSPACE",
        "class_name": "TechKnightWorkspace"
      },
      {
        "name": "TECHKNIGHT_SANDBOX",
        "class_name": "TechKnightSandbox"
      },
      {
        "name": "TASK_WRITE_BUDGETS",
        "class_name": "TaskWriteBudget"
      },
      {
        "name": "RUNTIME_SESSION_REGISTRY",
        "class_name": "RuntimeSessionRegistry"
      },
      {
        "name": "TENANT_RUNTIME_STATE",
        "class_name": "TenantRuntimeState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechKnightWorkspace"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TechKnightSandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TaskWriteBudget"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["RuntimeSessionRegistry"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TenantRuntimeState"]
    }
  ],
  "containers": [
    {
      "class_name": "TechKnightSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TECHKNIGHT_EVENTS",
        "queue": "techknight-mana-runtime-poc-events"
      }
    ],
    "consumers": [
      {
        "queue": "techknight-mana-runtime-poc-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "techknight-mana-runtime-poc-events-dlq"
      }
    ]
  }
}
