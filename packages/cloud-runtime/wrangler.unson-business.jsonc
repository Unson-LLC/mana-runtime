  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TECHKNIGHT_WORKSPACE",
        "class_name": "TechKnightWorkspace"
      },
      {
        "name": "TECHKNIGHT_SANDBOX",
        "class_name": "TechKnightSandbox"
      },
      {
        "name": "TASK_WRITE_BUDGETS",
        "class_name": "TaskWriteBudget"
      },
      {
        "name": "MEETING_MINUTES_WORKSPACE",
        "class_name": "MeetingMinutesWorkspace"
      },
      {
        "name": "MEETING_MINUTES_DEPLOYMENT_GATE",
        "class_name": "MeetingMinutesDeploymentGate"
      },
      {
        "name": "TASK_WRITE_APPROVALS",
        "class_name": "TaskWriteApproval"
      },
      {
        "name": "TASK_BOARD_BINDINGS",
        "class_name": "TaskBoardBinding"
      },
      {
        "name": "RUNTIME_SESSION_REGISTRY",
        "class_name": "RuntimeSessionRegistry"
      },
      {
        "name": "TENANT_RUNTIME_STATE",
        "class_name": "TenantRuntimeState"
      },
      {
        "name": "CONTRACT_LEDGER_STATE",
        "class_name": "ContractLedgerState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TechKnightWorkspace"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TechKnightSandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TaskWriteBudget"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["MeetingMinutesWorkspace"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TaskWriteApproval"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["RuntimeSessionRegistry"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["MeetingMinutesDeploymentGate"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["TaskBoardBinding"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["ContractLedgerState"]
    },
    {
      "tag": "v10",
      "new_sqlite_classes": ["TenantRuntimeState"]
    }
  ],
  "services": [
    {
      "binding": "BRAINBASE_TENANT_RUNTIME_SERVICE",
      "service": "brainbase-tenant-runtime"
    },
    {
      "binding": "SLACK_INSTALLATION_CONTROL_PLANE",
      "service": "brainbase-slack-installation-control-plane"
    }
  ],
  "containers": [
    {
      "class_name": "TechKnightSandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 6
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TECHKNIGHT_EVENTS",
        "queue": "unson-business-mana-runtime-events"
      },
      {
        "binding": "TASK_BOARD_REPAIRS",
        "queue": "unson-business-mana-task-board-repairs"
      },
      {
        "binding": "CONTRACT_LEDGER_SYNCS",
        "queue": "unson-business-contract-ledger-syncs"
      }
    ],
    "consumers": [
      {
        "queue": "unson-business-mana-runtime-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "unson-business-mana-runtime-events-dlq"
      },
      {
        "queue": "unson-business-mana-task-board-repairs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-mana-task-board-repairs-dlq"
      },
      {
        "queue": "unson-business-contract-ledger-syncs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "unson-business-contract-ledger-syncs-dlq"
      },
      {
        "queue": "unson-business-contract-ledger-syncs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *", "0 0 * * 1-5"]
  }
}
