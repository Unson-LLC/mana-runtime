{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "node /opt/mana/brainbase-judgment-hook.mjs", "timeout": 45 }]
    }],
    "PreToolUse": [{
      "matcher": ".*",
      "hooks": [{ "type": "command", "command": "node /opt/mana/brainbase-judgment-hook.mjs", "timeout": 45 }]
    }],
    "PostToolUse": [{
      "matcher": ".*",
      "hooks": [{ "type": "command", "command": "node /opt/mana/brainbase-judgment-hook.mjs", "timeout": 45 }]
    }],
    "PostToolUseFailure": [{
      "matcher": ".*",
      "hooks": [{ "type": "command", "command": "node /opt/mana/brainbase-judgment-hook.mjs", "timeout": 45 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "node /opt/mana/brainbase-judgment-hook.mjs", "timeout": 45 }]
    }]
  }
}
